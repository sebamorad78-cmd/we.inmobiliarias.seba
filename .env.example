# ── Sitio ───────────────────────────────────────────────
# URL pública definitiva (se usa en SEO, sitemap y links para compartir)
NEXT_PUBLIC_SITE_URL=https://www.tu-dominio.com.ar

# ── Panel interno ───────────────────────────────────────
# Clave larga y aleatoria para firmar las sesiones (mínimo 32 caracteres).
# Generar con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Primer usuario administrador. Se crea solo la primera vez que alguien ingresa
# al panel y todavía no hay usuarios cargados. Luego se gestiona desde Panel → Equipo.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Base de datos (producción) ──────────────────────────
# Sin estas variables el sitio usa data/db.json (ideal para desarrollo local).
# En producción (Vercel, Netlify, etc.) completar con los datos del proyecto Supabase.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=propiedades

# ── Aviso de consultas por email (opcional) ─────────────
# Cada consulta nueva se envía a LEADS_NOTIFY_EMAIL usando Resend (resend.com).
RESEND_API_KEY=
LEADS_NOTIFY_EMAIL=
LEADS_FROM_EMAIL=
